# check that expression sample columns have  matching geoID in the covariate data
all(names(expr)[-1] %in% covar$geoID)
# check that covariate geoIDs have matching expression column
all(covar$geoID %in% names(expr)[-1])
# check how many expression probes appear in the linker file
sum(expr$X %in% genes$PROBEID)
# check whether any probe IDs are repeated in the linker file
sum(duplicated(genes$PROBEID))
# attach gene names to the expression data by matching probe IDs
expr_named <- merge(genes, expr, by.x = "PROBEID", by.y = "X")
# check that many rows remain and for duplicate gene names
nrow(expr_named)
sum(duplicated(expr_named$GENE))
# seshape to long format: one row per gene per sample
expr_long <- pivot_longer(expr_named, cols = -c(PROBEID, GENE), names_to = "geoID", values_to = "expression")
# join covariates onto each sample by geoID
dat <- left_join(expr_long, covar, by = "geoID")
# confirm size (78,500 rows)
dim(dat)
# create vitamin D status, standard deficiency cutoff of 20 ng/mL
dat$vitD_status <- factor(ifelse(dat$mat_vitD < 20, "Deficient", "Sufficient"), levels = c("Sufficient", "Deficient"))
# create obesity status,standard BMI cutoff of 30 kg/m2
dat$obese <- factor(ifelse(dat$mat_BMI >= 30, "Obese", "Not obese"), levels = c("Not obese", "Obese"))
# check which known preeclampsia-related genes are on 500-probe array
intersect(c("FLT1", "ENG", "LEP", "PGF", "VEGFA", "PAPPA2", "INHBA", "HTRA1"), expr_named$GENE)
# for each gene, compare mean expression between preeclampsia and normal pregnancies
gene_rank <- dat %>%
group_by(GENE) %>%
summarise(mean_diff = mean(expression[preg_preeclampsia == "Preeclampsia"]) - mean(expression[preg_preeclampsia == "Normal"]),
p_value = t.test(expression ~ preg_preeclampsia)$p.value) %>%
arrange(p_value)
# show 10 genes with strongest difference
head(gene_rank, 10)
# show the range of expression values across genes and samples
summary(dat$expression)
# keep only rows for chosen gene
gene_dat <- filter(dat, GENE == "RUNDC3A")
# confirm one row per sample
nrow(gene_dat)
# plot the distribution of RUNDC3A expression across all samples
p1 <- ggplot(gene_dat, aes(x = expression)) +
geom_histogram(bins = 20, fill = "steelblue", color = "white") +
labs(x = "RUNDC3A Expression (log2)", y = "Number of Samples",
title = "Distribution of RUNDC3A Expression") +
theme_classic(base_size = 13)
p1
# Plot RUNDC3A expression against maternal BMI with a fitted regression line
p2 <- ggplot(gene_dat, aes(x = mat_BMI, y = expression)) +
geom_point(color = "steelblue", alpha = 0.7, size = 2) +
geom_smooth(method = "lm", formula = y ~ x, se = TRUE, color = "black") +
labs(x = "Maternal BMI (kg/m²)", y = "RUNDC3A Expression (log2)",
title = "RUNDC3A Expression by Maternal BMI") +
theme_classic(base_size = 13)
p2
# plot RUNDC3A expression by preeclampsia status, split by vitamin D status
p3 <- ggplot(gene_dat, aes(x = preg_preeclampsia, y = expression, fill = vitD_status)) +
geom_boxplot() +
scale_fill_manual(values = c("Sufficient" = "#E69F00", "Deficient" = "#56B4E9")) +
labs(x = "Pregnancy Outcome", y = "RUNDC3A Expression (log2)",
fill = "Vitamin D Status", title = "RUNDC3A Expression by Preeclampsia and Vitamin D Status") +
theme_classic(base_size = 13) +
theme(legend.position = "bottom")
p3
# Save each plot as png
ggsave("fig1_histogram.png", p1, width = 7, height = 5)
ggsave("fig2_scatter.png", p2, width = 7, height = 5)
ggsave("fig3_boxplot.png", p3, width = 7, height = 5)
# RUNDC3A plus the next two from gene_rank
myGenes <- c("RUNDC3A", "MOSPD1", "YIPF6")
# Check that all 3 genes are in data
myGenes %in% dat$GENE
# labels for variable names
myLabels <- list('mat_BMI' = bquote('Maternal BMI (kg/m'^2*')'),
'preg_preeclampsia' = 'Pregnancy Outcome',
'vitD_status' = 'Vitamin D Status')
myLabels
# function to make plots for each gene
plotGenes <- function(data,genelist,contVar,catVars) {
# set seed
set.seed(321)
# loop through all genes
for(i in genelist) {
# subset data to this gene
geneData <- data[data$GENE == i, ]
# gene label correction after feedback
geneLabel <- bquote(italic(.(i)) ~ 'Expression (log2)')
# hist of gene expression
myHist <- ggplot(geneData, aes(x = expression)) +
geom_histogram(bins = 20, fill = 'steelblue',color = 'white') +
labs(x = geneLabel, y = 'Number of Samples') +
theme_classic(base_size = 16)
# scatterplot of continuous covariate vs gene expression
myScatter <- ggplot(geneData, aes(x = .data[[contVar]], y = expression)) +
geom_point(color = 'steelblue', alpha = 0.7, size = 2) +
geom_smooth(method = 'lm', formula = y ~ x, color = 'black') +
labs(x = myLabels[[contVar]], y = geneLabel) +
theme_classic(base_size = 16)
#boxplot by both categorical covariates
myBox <- ggplot(geneData, aes(x = .data[[catVars[1]]], y = expression, fill = .data[[catVars[2]]])) +
geom_boxplot(outlier.shape = NA) +
geom_point(position = position_jitterdodge(jitter.width = 0.2), alpha = 0.5, size = 1.5) +
scale_fill_manual(values = c('#E69F00','#56B4E9')) +
labs(x = myLabels[[catVars[1]]], y = geneLabel,
fill = myLabels[[catVars[2]]]) +
theme_classic(base_size = 16) +
theme(legend.position = 'bottom')
# print 3 plots
print(myHist)
print(myScatter)
print(myBox)
# save 3 plots as png. named by gene
ggsave(paste0(i, '_histogram.png'), myHist, width = 7, height = 5)
ggsave(paste0(i, '_scatter.png'), myScatter, width = 7, height = 5)
ggsave(paste0(i, '_boxplot.png'), myBox, width = 7, height = 5)
}
}
# 3 plot types of for each of 3 genes
plotGenes(data = dat,
genelist = myGenes,
contVar = 'mat_BMI',
catVars = c('preg_preeclampsia', 'vitD_status'))
# function to build a table one, could not locate my previously built one
buildTableOne <- function(data,varList,nonnormVars,catVars) {
# define list of things to loop through
myVarList <- varList
# define somewhere to store results
myResults <- data.frame(row.names = myVarList,
'Value' = rep(NA,length(myVarList)))
# Loop through all variables
for (i in myVarList) {
# subset data
myData <- data[,i]
# categorical variables: n (%)
if (i %in% catVars) {
tempTab <- table(myData)
myResults[i, 'Value'] <- paste0(names(tempTab),': ',tempTab,' (',
round(tempTab/length(myData)*100,digits = 1),')',
collapse = ', ')
}
# non-normal variables: median [IQR]
else if (i %in% nonnormVars) {
myResults[i, 'Value'] <- paste0(round(median(myData),digits = 2),' [',
round(quantile(myData,1/4),digits = 2),', ',
round(quantile(myData,3/4),digits = 2),']')
}
# normal variables: mean (sd)
else {
myResults[i, 'Value'] <- paste0(round(mean(myData),digits = 2),' (',
round(sd(myData),digits = 2),')')
}
}
# return results
return(myResults)
}
# add vitamin D status to one row per woman covariate data
covar$vitD_status <- factor(ifelse(covar$mat_vitD < 20, 'Deficient', 'Sufficient'),
levels = c('Sufficient', 'Deficient'))
# check distributions of variables to choose mean (SD) vs median [IQR]
hist(covar$mat_age_yrs)
hist(covar$mat_BMI)
hist(covar$delivery_gestAge_wks)
# variables to include in the table
myVars <- c('mat_age_yrs', 'mat_BMI', 'delivery_gestAge_wks', 'vitD_status')
# build column for each group and one for everyone
normalTab <- buildTableOne(data = covar[covar$preg_preeclampsia == 'Normal', ], varList = myVars, nonnormVars = c('mat_BMI', 'delivery_gestAge_wks'), catVars = 'vitD_status')
peTab <- buildTableOne(data = covar[covar$preg_preeclampsia == 'Preeclampsia', ], varList = myVars, nonnormVars = c('mat_BMI', 'delivery_gestAge_wks'), catVars = 'vitD_status')
allTab <- buildTableOne(data = covar, varList = myVars, nonnormVars = c('mat_BMI', 'delivery_gestAge_wks'), catVars = 'vitD_status')
# combine three columns into one table with readable row names
tableOne <- data.frame(Normal = normalTab$Value, Preeclampsia = peTab$Value, Overall = allTab$Value,
row.names = c('Maternal age (years), mean (SD)',
'Maternal BMI (kg/m$^2$), median [IQR]',
'Gestational age at delivery (weeks), median [IQR]',
'Vitamin D status, n (%)'))
tableOne
# load knitr for kable function (ran in console)
library(knitr)
# print table as latex code to paste into overleaf
kable(tableOne, format = 'latex', booktabs = TRUE, escape = FALSE,
col.names = c('Normal (n = 110)', 'Preeclampsia (n = 47)', 'Overall (n = 157)'))
# load pheatmap
library(pheatmap)
# top 10 genes from preeclampsia mean difference ranking
top10 <- gene_rank$GENE[1:10]
# keep the 10 and use gene names as row names
heatData <- expr_named[expr_named$GENE %in% top10, ]
row.names(heatData) <- heatData$GENE
# matrix of genes (rows) by samples (colums), in same sample order as covar
heatMat <- as.matrix(heatData[, covar$geoID])
# Tracking bars
# data frame of 2 catVars with sample ID as row name
annot <- data.frame(row.names = covar$geoID, covar$preg_preeclampsia, covar$vitD_status)
colnames(annot) <- c('Pregnancy Outcome', 'Vitamin D Status')
# colors
annColors <- list('Pregnancy Outcome' = c(Normal = 'grey80', Preeclampsia = 'firebrick'),
'Vitamin D Status' = c(Sufficient = '#E69F00', Deficient = '#56B4E9'))
# Draw Heatmap
# adjust width after seeing result
fig.width = 25
# italicize gene names for row labels
geneNames <- as.expression(lapply(row.names(heatMat), function(g) bquote(italic(.(g)))))
# drat teh clustered heatmap with tracking bars
myHeat <- pheatmap(heatMat,
scale = 'row',
treeheight_col = 30,
clustering_distance_rows = 'euclidean',
clustering_distance_cols = 'euclidean',
clustering_method = 'complete',
annotation_col = annot,
annotation_colors = annColors,
labels_row = geneNames,
show_colnames = FALSE,
fontsize = 12)
# save heatmpa as PNG for overleaf
ggsave('heatmap.png', myHeat$gtable, width = 25, height = 6)
library(ggbeeswarm)
# label each gene a p<0.05 or not
gene_rank$Significance <- factor(ifelse(gene_rank$p_value < 0.05, 'p < 0.05', 'p >= 0.05'), levels = c('p >= 0.05', 'p < 0.05'))
gene_rank <- gene_rank[order(gene_rank$Significance), ]
# beeswarm of all 500 genes' mean differences, colored by p-value
myBees <- ggplot(gene_rank, aes(x = '', y = mean_diff, fill = Significance, color = Significance)) +
geom_quasirandom(shape = 21, size = 3, stroke = 0.8) +
geom_hline(yintercept = 0, linetype = 'dashed') +
scale_fill_manual(values = c('p >= 0.05' = '#9ECAE1', 'p < 0.05' = 'firebrick')) +
scale_color_manual(values = c('p >= 0.05' = '#6BAED6', 'p < 0.05' = 'black')) +
coord_flip(ylim = range(gene_rank$mean_diff) * 1.1) +
labs(x = NULL, y = 'Mean Difference in Expression (Preeclampsia - Normal, log2)', color = NULL, fill = NULL) +
theme_classic(base_size = 16) +
theme(legend.position = 'bottom', axis.ticks.y = element_blank())
# myBees
ggsave('beeswarm.png', myBees, width = 10, height = 6)
